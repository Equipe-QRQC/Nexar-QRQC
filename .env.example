# Copie para .env e preencha. O arquivo .env nunca deve ser versionado.

# ── Segurança (obrigatório em qualquer ambiente compartilhado) ────────────────
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Senha do administrador. Se definida, é (re)aplicada a cada inicialização.
ADMIN_EMAIL=admin@nexar.com
ADMIN_PASSWORD=

# ── IA ────────────────────────────────────────────────────────────────────────
# Gemini: diagnóstico da ocorrência, marcações no diagrama e assistente (chat)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# OpenAI: Sensor Visual, Visualização 3D e inspeção de documento (app mobile)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=5000
# Caminho do banco SQLite (padrão: qrqc.db na pasta do projeto)
# DATABASE_PATH=
# Reativa o seletor de idioma EN/ES (tradução ainda parcial)
# ENABLE_I18N=1

# ── E-mail de suporte (opcional) ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SUPORTE_EMAIL_DESTINO=
SUPORTE_EMAIL_FROM=
